        "ru": {
          "name": "Delta Type",
          "description": "Фоновая статистика печати Linux и отдельный тренажёр. Необязательная локальная история физических клавиш.",
          "publisher": "Delta",
          "icon": "keyboard",
          "category": "input",
          "settings": [
            {
              "key": "enabled",
              "type": "boolean",
              "default": true,
              "label": "Собирать статистику печати"
            },
            {
              "key": "backgroundEnabled",
              "type": "boolean",
              "default": true,
              "label": "Фоновый сбор нажатий"
            },
            {
              "key": "language",
              "type": "select",
              "default": "unknown",
              "label": "Раскладка клавиатуры (вручную)",
              "help": "evdev передаёт физические клавиши, а не активную раскладку или текст. Скорость и число символов — оценки.",
              "options": [
                {
                  "value": "unknown",
                  "label": "Неизвестна"
                },
                {
                  "value": "ru",
                  "label": "Русская"
                },
                {
                  "value": "en",
                  "label": "Английская"
                }
              ]
            },
            {
              "key": "recordKeys",
