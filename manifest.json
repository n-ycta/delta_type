{
  "id": "typing",
  "version": "0.2.0",
  "description": "Privacy-first aggregate typing statistics",
  "metadata": {
    "ui": {
      "id": "dev.delta.type",
      "name": "Delta Type",
      "description": "Opt-in RU/EN typing aggregates without recording text. Browser trainer or trusted aggregate clients.",
      "publisher": "Delta",
      "version": "0.2.0",
      "contract": "^1.4.0",
      "icon": "keyboard",
      "category": "input",
      "runtime": {
        "targets": [
          "desktop",
          "vps",
          "container"
        ]
      },
      "capabilities": [
        "metrics.timeseries",
        "actions",
        "settings.live"
      ],
      "settings": [
        {
          "key": "enabled",
          "label": "Collect aggregate sessions",
          "type": "boolean",
          "default": true
        }
      ],
      "actions": [
        {
          "id": "flush",
          "label": "Send accumulated aggregates"
        }
      ],
      "metrics": [
        {
          "id": "wpm",
          "label": "Typing speed",
          "description": "Standard WPM: five characters per word.",
          "kind": "gauge",
          "unit": "wpm",
          "precision": 1,
          "better": "higher",
          "dimensions": [
            {
              "id": "language",
              "label": "Language",
              "values": [
                {
                  "id": "ru",
                  "label": "Russian"
                },
                {
                  "id": "en",
                  "label": "English"
                }
              ]
            }
          ],
          "aggregations": [
            "avg",
            "max",
            "min",
            "p95"
          ],
          "visualizations": [
            "timeseries",
            "comparison",
            "stat"
          ]
        },
        {
          "id": "accuracy",
          "label": "Without corrections",
          "description": "1 − corrections / entered characters. Not a spelling or text accuracy test.",
          "kind": "ratio",
          "unit": "ratio",
          "precision": 1,
          "better": "higher",
          "dimensions": [
            {
              "id": "language",
              "label": "Language",
              "values": [
                {
                  "id": "ru",
                  "label": "Russian"
                },
                {
                  "id": "en",
                  "label": "English"
                }
              ]
            }
          ],
          "aggregations": [
            "avg",
            "min"
          ],
          "visualizations": [
            "gauge",
            "timeseries"
          ]
        },
        {
          "id": "keystrokes",
          "label": "Characters entered",
          "kind": "counter",
          "unit": "",
          "precision": 0,
          "aggregations": [
            "sum"
          ],
          "visualizations": [
            "bar",
            "heatmap",
            "stat"
          ]
        }
      ],
